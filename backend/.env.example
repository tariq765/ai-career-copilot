APP_NAME="AI Career Copilot"
ENVIRONMENT=production
DEBUG=false
SECRET_KEY="your-production-jwt-secret-key-here"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Neon Database URL
DATABASE_URL="postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-endpoint.neon.tech/neondb?ssl=require"

# AI Provider Key (OpenRouter / OpenAI / Gemini)
AI_PROVIDER="openrouter"
AI_API_KEY=""
AI_MODEL_NAME="openai/gpt-4o-mini"
AI_BASE_URL="https://openrouter.ai/api/v1"

CORS_ORIGINS=["http://localhost:3000","https://ai-career-copilot.vercel.app"]
MAX_UPLOAD_SIZE_MB=5
